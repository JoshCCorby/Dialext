{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/badge/**",
              "components/core/button/**",
              "components/core/card/**",
              "components/core/dialog/**",
              "components/core/feedback/**",
              "components/core/forms/**",
              "components/core/icon/**",
              "components/core/tabs/**",
              "components/product/audio/**",
              "components/product/language/**",
              "components/product/meeting-header/**",
              "components/product/search/**",
              "components/product/status/**",
              "components/product/summary/**",
              "components/product/transcript/**",
              "ui_kits/web-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Sans|Source Serif 4|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Instrument Sans, Source Serif 4, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|owner|dueDate|done|generated|onToggle|key|ref|className|style|children)$/]",
        "message": "<ActionItem> doesn't accept that prop. Declared props: text, owner, dueDate, done, generated, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudioPlayer'] > JSXAttribute > JSXIdentifier[name!=/^(?:duration|current|playing|onTogglePlay|label|key|ref|className|style|children)$/]",
        "message": "<AudioPlayer> doesn't accept that prop. Declared props: duration, current, playing, onTogglePlay, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconPosition|disabled|loading|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconPosition, disabled, loading, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|disabled|id|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, onChange, disabled, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:statement|owner|source|onCite|key|ref|className|style|children)$/]",
        "message": "<DecisionItem> doesn't accept that prop. Declared props: statement, owner, source, onCite."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|onClose|actions|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, onClose, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|action|icon|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, description, action, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|variant|onClick|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, variant, onClick, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tertiary|primary)$/]",
        "message": "<IconButton> variant must be one of 'tertiary' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|error|value|onChange|placeholder|type|required|disabled|id|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, help, error, value, onChange, placeholder, type, required, disabled, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='LanguageOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|own|key|ref|className|style|children)$/]",
        "message": "<LanguageOption> doesn't accept that prop. Declared props: value, label, own."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeetingHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|date|duration|languages|visibility|status|actions|key|ref|className|style|children)$/]",
        "message": "<MeetingHeader> doesn't accept that prop. Declared props: title, date, duration, languages, visibility, status, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='OriginalTranslationControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|onChange|targetLanguage|key|ref|className|style|children)$/]",
        "message": "<OriginalTranslationControl> doesn't accept that prop. Declared props: mode, onChange, targetLanguage."
      },
      {
        "selector": "JSXOpeningElement[name.name='OriginalTranslationControl'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:Translation|Original|Compare)$/]",
        "message": "<OriginalTranslationControl> mode must be one of 'Translation' | 'Original' | 'Compare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PermissionBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|key|ref|className|style|children)$/]",
        "message": "<PermissionBadge> doesn't accept that prop. Declared props: state."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessingStages'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|failed|key|ref|className|style|children)$/]",
        "message": "<ProcessingStages> doesn't accept that prop. Declared props: current, failed."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessingStages'] > JSXAttribute[name.name='current'] > Literal[value!=/^(?:Uploading|Preparing audio|Transcribing|Identifying languages|Translating|Creating minutes|Indexing for search|Complete)$/]",
        "message": "<ProcessingStages> current must be one of 'Uploading' | 'Preparing audio' | 'Transcribing' | 'Identifying languages' | 'Translating' | 'Creating minutes' | 'Indexing for search' | 'Complete'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|value|checked|onChange|disabled|id|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label, name, value, checked, onChange, disabled, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecordingStatus'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|key|ref|className|style|children)$/]",
        "message": "<RecordingStatus> doesn't accept that prop. Declared props: state."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchResult'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|date|speakers|language|snippet|matchTerm|timestamp|onOpen|key|ref|className|style|children)$/]",
        "message": "<SearchResult> doesn't accept that prop. Declared props: title, date, speakers, language, snippet, matchTerm, timestamp, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|onClose|side|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, title, children, onClose, side."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Sheet> side must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeakerLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|language|key|ref|className|style|children)$/]",
        "message": "<SpeakerLabel> doesn't accept that prop. Declared props: name, language."
      },
      {
        "selector": "JSXOpeningElement[name.name='SummaryBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|generatedAt|outputLanguage|onEdit|key|ref|className|style|children)$/]",
        "message": "<SummaryBlock> doesn't accept that prop. Declared props: children, generatedAt, outputLanguage, onEdit."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onRemove|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|onUndo|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, children, onUndo."
      },
      {
        "selector": "JSXOpeningElement[name.name='TranscriptSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:speaker|language|timestamp|original|translation|uncertainWords|edited|selected|onPlay|key|ref|className|style|children)$/]",
        "message": "<TranscriptSegment> doesn't accept that prop. Declared props: speaker, language, timestamp, original, translation, uncertainWords, edited, selected, onPlay."
      },
      {
        "selector": "JSXOpeningElement[name.name='UncertaintyMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onOpen|resolved|key|ref|className|style|children)$/]",
        "message": "<UncertaintyMarker> doesn't accept that prop. Declared props: children, onOpen, resolved."
      }
    ]
  },
